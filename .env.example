# SMTP Configuration for Email Notifications
# Use Google App Password (not regular Gmail password)

# Global SMTP settings (used for all events if event-specific credentials aren't set)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=itassociation.notifications@gmail.com
SMTP_PASS=pyuq hias kpvz ltfq

# Optional: Event-specific Gmail accounts (override global SMTP_USER/SMTP_PASS)
# EVENT_EMAIL_USER_LLM=example@gmail.com
# EVENT_EMAIL_PASSWORD_LLM=xxxx xxxx xxxx xxxx

# EVENT_EMAIL_USER_CODE_BUILD=example@gmail.com
# EVENT_EMAIL_PASSWORD_CODE_BUILD=xxxx xxxx xxxx xxxx

# EVENT_EMAIL_USER_INNOVATION=example@gmail.com
# EVENT_EMAIL_PASSWORD_INNOVATION=xxxx xxxx xxxx xxxx

# EVENT_EMAIL_USER_CYBER_QUEST=example@gmail.com
# EVENT_EMAIL_PASSWORD_CYBER_QUEST=xxxx xxxx xxxx xxxx

# EVENT_EMAIL_USER_DESIGN_DEPLOY=example@gmail.com
# EVENT_EMAIL_PASSWORD_DESIGN_DEPLOY=xxxx xxxx xxxx xxxx

# EVENT_EMAIL_USER_TECH_CONNECT=example@gmail.com
# EVENT_EMAIL_PASSWORD_TECH_CONNECT=xxxx xxxx xxxx xxxx

# EVENT_EMAIL_USER_EVENT6=example@gmail.com
# EVENT_EMAIL_PASSWORD_EVENT6=xxxx xxxx xxxx xxxx

# Frontend CORS settings
FRONTEND_ORIGIN=http://localhost:5173,https://your-site.vercel.app

# Google Sheets Configuration
GOOGLE_SHEET_ID=your-sheet-id-here
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY=your-private-key-here
