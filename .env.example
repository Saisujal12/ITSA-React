# Copy to `.env` in the project root and fill in locally. Never commit `.env`.
# Both the Vite frontend and the Express backend (`npm run server`) read the
# root `.env`. In production, set these in Vercel → Project → Settings →
# Environment Variables instead.

# ============================================================
# Frontend (Vite)
# ============================================================
# Everything prefixed VITE_ is bundled into the browser JavaScript — never put
# secrets in VITE_ variables.

# Base URL of the backend used by the browser. Leave empty to call same-origin
# /api (recommended): the Vite dev/preview proxy locally, the serverless
# function on Vercel.
VITE_API_URL=

# Where the Vite dev/preview server proxies /api (not bundled).
# macOS: AirPlay Receiver uses port 5000 — run the backend with PORT=5050 and
# point this at http://127.0.0.1:5050.
DEV_API_PROXY_TARGET=http://127.0.0.1:5000

# ============================================================
# Backend (Express — server/ locally, api/index.js on Vercel)
# ============================================================

# Local server port (ignored on Vercel).
PORT=5000

# `production` makes the admin cookie Secure (HTTPS only). Vercel sets it.
NODE_ENV=

# Extra allowed CORS origins, comma separated (localhost:5173 and *.vercel.app
# are already allowed).
FRONTEND_ORIGIN=

# ------------------------------------------------------------
# Admin authentication
# ------------------------------------------------------------
ADMIN_USERNAME=
# scrypt hash in `salt:key` form. Generate with:
#   node server/scripts/createAdminHash.js
ADMIN_PASSWORD_HASH=
# Long random string used to sign the admin session cookie.
ADMIN_SESSION_SECRET=

# ------------------------------------------------------------
# Google Sheets (service account)
# ------------------------------------------------------------
# Either the whole service-account JSON on one line…
GOOGLE_SERVICE_ACCOUNT_JSON=
# …or the email + private key pair.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Tab name inside each sheet (default: Registrations).
GOOGLE_SHEET_TAB_NAME=
# Fallback sheet for the workshop (llm) when EVENT_SHEET_ID_LLM is empty.
GOOGLE_SHEET_ID=

# One spreadsheet per event.
EVENT_SHEET_ID_LLM=
EVENT_SHEET_ID_CODE_BUILD=
EVENT_SHEET_ID_INNOVATION=
EVENT_SHEET_ID_CYBER_QUEST=
EVENT_SHEET_ID_DESIGN_DEPLOY=
EVENT_SHEET_ID_TECH_CONNECT=
EVENT_SHEET_ID_EVENT6=

# ------------------------------------------------------------
# Email (Gmail + app password via Nodemailer)
# ------------------------------------------------------------
# Default sender for the workshop (llm) when no per-event sender is set.
EMAIL_USER=
EMAIL_APP_PASSWORD=

# Per-event senders.
EVENT_EMAIL_USER_LLM=
EVENT_EMAIL_PASSWORD_LLM=
EVENT_EMAIL_USER_CODE_BUILD=
EVENT_EMAIL_PASSWORD_CODE_BUILD=
EVENT_EMAIL_USER_INNOVATION=
EVENT_EMAIL_PASSWORD_INNOVATION=
EVENT_EMAIL_USER_CYBER_QUEST=
EVENT_EMAIL_PASSWORD_CYBER_QUEST=
EVENT_EMAIL_USER_DESIGN_DEPLOY=
EVENT_EMAIL_PASSWORD_DESIGN_DEPLOY=
EVENT_EMAIL_USER_TECH_CONNECT=
EVENT_EMAIL_PASSWORD_TECH_CONNECT=
